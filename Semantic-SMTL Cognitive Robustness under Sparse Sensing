        jcas = np.array([max(0.82 * (1 - s) - 0.03, 0.1) for s in x])
    if sran is None:
        sran = np.array([max(0.88 * (1 - 0.8 * s) - 0.08, 0.1) for s in x])
    if graph is None:
        graph = np.array([max(0.78 * (1 - 1.2 * s) - 0.05, 0.1) for s in x])
