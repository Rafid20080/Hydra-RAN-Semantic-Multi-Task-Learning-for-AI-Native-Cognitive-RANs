    task_sensitive = curves.get('task_sensitive')
    standard_ema = curves.get('standard_ema')
    jcas = curves.get('jcas')
    sran = curves.get('sran')
    graph = curves.get('graph')
    drl = curves.get('drl')
    
    # If any curves are missing, use fallback deterministic values
