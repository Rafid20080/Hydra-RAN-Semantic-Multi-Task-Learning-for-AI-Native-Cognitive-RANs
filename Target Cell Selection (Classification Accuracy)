def create_convergence_figure(results, save_path=None, title_prefix=''):
    """
    Create publication-quality figure with all three task convergence plots.
    
    Args:
        results: dict from generate_all_curves
        save_path: path to save the figure
        title_prefix: prefix for the figure title
    """
    # IEEE column width: 3.5 inches for single column
    fig, axes = plt.subplots(1, 3, figsize=(7.25, 2.8), dpi=300)
    
    # Task configurations
    tasks = [
        {
            'key': 'target_accuracy',
            'ylabel': 'Cell Accuracy',
            'ylim': (0.0, 1.0),
            'title': '(a) Target Cell Selection'
        },
        {
            'key': 'resource_nrmse',
            'ylabel': 'NRMSE',
            'ylim': (0.0, 0.45),
            'title': '(b) Resource Demand Estimation'
        },
        {
            'key': 'beam_accuracy',
            'ylabel': 'Beam Accuracy',
            'ylim': (0.0, 1.0),
            'title': '(c) Interference Mitigation'
        }
    ]
    
    # Color map consistent across all subplots
    color_map = {
        'Hydra-RAN': '#1f77b4',
        'Hydra-RAN (no VIB)': '#2ca02c',
        'Hydra-RAN\n(no uncertainty weighting)': '#ff7f0e',
        'S-RAN': '#d62728',
        'DRL-Only': '#9467bd'
    }
    
    # Marker map for each baseline
    marker_map = {
        'Hydra-RAN': 's',                  # Square
        'Hydra-RAN (no VIB)': '^',         # Triangle up
        'Hydra-RAN\n(no uncertainty weighting)': 'D',  # Diamond
        'S-RAN': 'o',                     # Circle
        'DRL-Only': 'v'                   # Triangle down
    }
    
    for idx, task in enumerate(tasks):
        ax = axes[idx]
        plot_task_convergence(
            ax, results, task['key'], 
            ylabel=task['ylabel'], 
            ylim=task['ylim'],
            color_map=color_map,
            marker_map=marker_map,
            show_legend=(idx == 2),  # Show legend only on last subplot
            title=task['title']
        )
    
    # Add overall title if provided
    if title_prefix:
        fig.suptitle(title_prefix, fontsize=12, fontweight='bold')
    
    # Adjust layout
    plt.tight_layout()
    
    if save_path:
        plt.savefig(save_path, dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        print(f"Figure saved to {save_path}")
    
    plt.show()
    return fig, axes


