def plot_task_convergence(ax, results, task_name, ylabel, ylim=None, 
                          color_map=None, marker_map=None, show_legend=True,
                          title=None, show_markers=True):
    """
    Plot convergence curves for a single task.
    
    Args:
        ax: matplotlib axis
        results: dict from generate_all_curves
        task_name: string identifying the task
        ylabel: string for y-axis label
        ylim: tuple for y-axis limits
        color_map: dict mapping model names to colors
        marker_map: dict mapping model names to markers
        show_legend: boolean
        title: title for the subplot
        show_markers: boolean to show markers
    """
    if color_map is None:
        color_map = {
            'Hydra-RAN': '#1f77b4',           # Blue
            'Hydra-RAN (no VIB)': '#2ca02c',   # Green
            'Hydra-RAN\n(no uncertainty weighting)': '#ff7f0e',  # Orange
            'S-RAN': '#d62728',                # Red
            'DRL-Only': '#9467bd'              # Purple
        }
    
    if marker_map is None:
        marker_map = {
            'Hydra-RAN': 's',                  # Square
            'Hydra-RAN (no VIB)': '^',         # Triangle up
            'Hydra-RAN\n(no uncertainty weighting)': 'D',  # Diamond
            'S-RAN': 'o',                     # Circle
            'DRL-Only': 'v'                   # Triangle down
        }
    
    # Model order for legend
    model_order = ['Hydra-RAN', 'Hydra-RAN (no VIB)', 
                   'Hydra-RAN\n(no uncertainty weighting)', 
                   'S-RAN', 'DRL-Only']
    
    # Determine if higher is better (accuracy) or lower is better (NRMSE)
    higher_is_better = 'accuracy' in task_name.lower()
    
    steps = np.arange(len(results['Hydra-RAN'][task_name]['mean']))
    
    # Sample points for markers
    marker_step = max(500, len(steps) // 10) if show_markers else len(steps) + 1
    
    # Create line objects for legend
    legend_handles = []
    
    for model_name in model_order:
        if model_name not in results:
            continue
        
        data = results[model_name][task_name]
        mean = data['mean']
        std = data['std']
        color = color_map.get(model_name, 'gray')
        marker = marker_map.get(model_name, 'o')
        
        # Main curve
        line, = ax.plot(steps, mean, color=color, linewidth=2.5, 
                        marker=marker, markevery=marker_step,
                        markersize=6, markerfacecolor=color,
                        markeredgecolor='white', markeredgewidth=0.5,
                        label=model_name)
        legend_handles.append(line)
        
        # Confidence interval (shaded)
        ax.fill_between(steps, mean - std, mean + std, 
                        color=color, alpha=0.15, linewidth=0)
    
    # Formatting
    ax.set_xlabel('Training Steps', fontsize=11)
    ax.set_ylabel(ylabel, fontsize=11)
    
    # Remove top and right spines for cleaner look
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    
    if ylim is not None:
        ax.set_ylim(ylim)
    
    ax.grid(True, alpha=0.3, linestyle='--', linewidth=0.5)
    
    if title:
        ax.set_title(title, fontsize=10, fontweight='bold')
    
    if show_legend:
        ax.legend(handles=legend_handles, loc='lower right', fontsize=7, 
                 framealpha=0.95, fancybox=True)


