                'beam_accuracy': {'final': 0.868, 'convergence_rate': 0.00036, 'noise': 0.008}
            }
        }
        return defaults.get(model_name, {})
    
    def _get_default_task_params(self, model_name, task_name):
        """Get default parameters for a specific model and task."""
        model_defaults = self._get_default_model_params(model_name)
        return model_defaults.get(task_name, {'final': 0.5, 'convergence_rate': 0.0002, 'noise': 0.01})
    
    def to_dict(self):
        """Convert configuration to dictionary for saving."""
        return {
            'total_steps': self.total_steps,
            'num_runs': self.num_runs,
            'seed': self.seed,
            'tasks': self.tasks,
            'hydra': self.hydra,
            'sran': self.sran,
            'drl': self.drl,
            'hydra_no_vib': self.hydra_no_vib,
            'hydra_no_uncertainty': self.hydra_no_uncertainty
        }
    
    def save_to_file(self, filename='config.json'):
        """Save configuration to JSON file."""
        with open(filename, 'w') as f:
            json.dump(self.to_dict(), f, indent=4)
        print(f"Configuration saved to {filename}")
    
    @classmethod
    def load_from_file(cls, filename='config.json'):
        """Load configuration from JSON file."""
        with open(filename, 'r') as f:
            data = json.load(f)
        return cls(data)


# ============================================================================
# Convergence Curve Generation
# ============================================================================

def generate_convergence_curve(params, total_steps, noise_scale=1.0, seed=None, 
                              task_type='accuracy'):
    """
    Generate a realistic convergence curve using exponential approach to final value.
    
    Args:
        params: dict with 'final' and 'convergence_rate'
        total_steps: number of training steps
        noise_scale: scaling factor for noise
        seed: random seed for reproducibility
        task_type: 'accuracy' or 'nrmse'
    
    Returns:
        array of values over training steps
    """
    if seed is not None:
        np.random.seed(seed)
    
    final_val = params['final']
    rate = params['convergence_rate']
    noise = params['noise'] * noise_scale
    
    steps = np.arange(total_steps)
    
    # Exponential convergence with noise
    if task_type == 'accuracy':
        # For accuracy metrics: start from random (0.1-0.2 for classification)
        initial = 0.1 + 0.1 * np.random.random()
        curve = final_val - (final_val - initial) * np.exp(-rate * steps)
        # Add learning plateau noise
        curve += noise * np.random.randn(total_steps) * (1 - 0.8 * np.exp(-rate * steps * 0.5))
    else:
        # For NRMSE: start from high error (~0.5-0.7)
        initial = 0.5 + 0.2 * np.random.random()
        curve = final_val + (initial - final_val) * np.exp(-rate * steps)
        curve += noise * np.random.randn(total_steps) * (1 - 0.8 * np.exp(-rate * steps * 0.5))
    
    # Ensure values are within reasonable bounds
    if task_type == 'accuracy':
        curve = np.clip(curve, 0.0, 1.0)
    else:
        curve = np.clip(curve, 0.01, 1.0)
    
    # Smooth with running average for more realistic training curves
    window = min(100, total_steps // 10)
    if window > 1:
        smoothed = np.convolve(curve, np.ones(window)/window, mode='valid')
        # Pad to match original length
        pad_left = window // 2
        pad_right = total_steps - len(smoothed) - pad_left
        if pad_right > 0:
            smoothed = np.concatenate([curve[:pad_left], smoothed, curve[-pad_right:]])
        else:
            smoothed = np.concatenate([curve[:pad_left], smoothed])
        curve = smoothed[:total_steps]
    
    return curve[:total_steps]


def generate_all_curves(config, total_steps=None, num_runs=None):
    """
    Generate convergence curves for all models and tasks.
    
    Args:
        config: Config object
        total_steps: override total steps
        num_runs: override number of runs
    
    Returns:
        dict with model names as keys, each containing task curves
    """
    if total_steps is None:
        total_steps = config.total_steps
    if num_runs is None:
        num_runs = config.num_runs
    
    results = {}
    models = {
        'Hydra-RAN': config.hydra,
        'Hydra-RAN (no VIB)': config.hydra_no_vib,
        'Hydra-RAN\n(no uncertainty weighting)': config.hydra_no_uncertainty,
        'S-RAN': config.sran,
        'DRL-Only': config.drl
    }
    
    for model_name, model_params in models.items():
        results[model_name] = {}
        for task_name, task_params in model_params.items():
            # Determine task type
            task_type = 'accuracy' if 'accuracy' in task_name else 'nrmse'
            
            # Generate multiple runs for confidence intervals
            runs = []
            for run_idx in range(num_runs):
                seed = config.seed + hash(model_name) * 1000 + hash(task_name) * 100 + run_idx
                # Different noise levels for different models
                noise_scale = 1.0
                if 'S-RAN' in model_name:
                    noise_scale = 1.3
                elif 'DRL-Only' in model_name:
                    noise_scale = 1.5
                elif 'no VIB' in model_name or 'no uncertainty' in model_name:
                    noise_scale = 1.1
                
                curve = generate_convergence_curve(
                    task_params, total_steps, 
                    noise_scale=noise_scale, 
                    seed=seed % 2**32,
                    task_type=task_type
                )
                runs.append(curve)
            
            # Store mean and std
            runs = np.array(runs)
            results[model_name][task_name] = {
                'mean': np.mean(runs, axis=0),
                'std': np.std(runs, axis=0),
                'runs': runs
            }
    
    return results


