def analyze_convergence_rates(results, total_steps):
    """
    Compute and display convergence statistics for each model and task.
    """
    print("\n" + "=" * 70)
    print("Convergence Analysis (Steps to reach 90% of final performance)")
    print("=" * 70)
    
    model_order = ['Hydra-RAN', 'Hydra-RAN (no VIB)', 
                   'Hydra-RAN\n(no uncertainty weighting)', 
                   'S-RAN', 'DRL-Only']
    
    task_labels = {
        'target_accuracy': 'Target Cell Selection',
        'resource_nrmse': 'Resource Demand (NRMSE)',
        'beam_accuracy': 'Interference Mitigation'
    }
    
    convergence_data = {}
    
    for task_name in task_labels.keys():
        print(f"\n{task_labels[task_name]}:")
        for model in model_order:
            if model not in results:
                continue
            
            data = results[model][task_name]
            mean = data['mean']
            final_val = mean[-1]
            
            # Determine if higher is better
            if 'accuracy' in task_name:
                target = 0.9 * final_val
                idx = np.where(mean > target)[0]
            else:
                target = 1.1 * final_val
                idx = np.where(mean < target)[0]
            
            if len(idx) > 0:
                steps_to_90 = idx[0]
            else:
                steps_to_90 = total_steps
            
            print(f"  {model}: {steps_to_90} steps (final: {final_val:.3f})")
            convergence_data[(model, task_name)] = steps_to_90
    
    return convergence_data


